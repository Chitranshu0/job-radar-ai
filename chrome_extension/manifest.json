{
  "manifest_version": 3,
  "name": "Job Radar AI",
  "version": "1.0",
  "description": "AI-powered Resume Analyzer & Job Description Matcher",
  "action": {
    "default_popup": "popup.html"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
